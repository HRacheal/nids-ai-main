# ============================================================
# DeepShield AI - Git Ignore Rules
# ============================================================

# Python cache and compiled files
__pycache__/
*.py[cod]
.pytest_cache/
*.pyo

# Virtual environments
.venv/
venv/
env/

# ============================================================
# Datasets
# Downloaded from official sources; do not commit raw datasets
# ============================================================

data/raw/*
data/interim/*
data/processed/*
data/external/*

# Preserve dataset directory placeholders
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Dataset file formats
data/*.csv
data/*.txt
data/*.zip
data/*.gz
data/*.pcap
data/*.parquet

# ============================================================
# Trained models
# IMPORTANT: Keep trained model artifacts in Git
# ============================================================

# Do not ignore artifacts/models/
# Required model files include .joblib, .pkl, .pt and preprocessors.

# Ignore temporary model caches only
artifacts/cache/
artifacts/predictions/
ml/models/

# ============================================================
# Generated reports
# ============================================================

reports/*.pdf
reports/*.json

# ============================================================
# Notebooks
# ============================================================

.ipynb_checkpoints/

# ============================================================
# IDE and operating system files
# ============================================================

.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# Dashboard runtime state
# ============================================================

artifacts/runtime/
dist/

# ============================================================
# Secrets and environment files
# ============================================================

.env
.env.*
!.env.example

# ============================================================
# Runtime and experiment logs
# ============================================================

*.log
artifacts/metrics/**/runs/
artifacts/preliminary/*.log
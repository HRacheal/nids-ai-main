!data/interim/.gitkeep
!data/processed/.gitkeep
data/*.csv
data/*.txt
data/*.zip
data/*.gz
data/*.pcap

# Trained models and caches (metrics and figures ARE committed)
artifacts/models/*
!artifacts/models/.gitkeep
artifacts/cache/
artifacts/predictions/
ml/models/

# Generated session reports
reports/*.pdf
reports/*.json

# Notebooks
.ipynb_checkpoints/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# dashboard runtime state (prediction history database)
artifacts/runtime/
dist/

# Secrets and environment files
.env
.env.*
!.env.example

# Runtime and experiment logs
*.log
artifacts/metrics/**/runs/
artifacts/preliminary/*.log
